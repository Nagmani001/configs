{
  "$schema": "https://opencode.ai/config.json",
  "model": "foundry/gpt-5.5",
  "small_model": "foundry/gpt-5.5",
  "provider": {
    "foundry": {
      "npm": "@ai-sdk/openai",
      "name": "Azure Foundry",
      "options": {
        "baseURL": "https://crator-foundry.openai.azure.com/openai/v1",
        "apiKey": "REPLACE_WITH_YOUR_API_KEY"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5"
        }
      }
    }
  }
}
